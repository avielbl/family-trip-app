rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user is an admin of the given family
    function isFamilyAdminOf(familyId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/families/$(familyId)).data.adminUids;
    }

    // Helper: user may administer the trip — either the trip's own adminUid,
    // or an admin of the family the trip belongs to.
    function isAdmin(tripCode) {
      let trip = get(/databases/$(database)/documents/trips/$(tripCode)).data;
      return request.auth != null && (
        ('adminUid' in trip && trip.adminUid == request.auth.uid) ||
        ('familyId' in trip && isFamilyAdminOf(trip.familyId))
      );
    }

    // User profiles — each user can only read/write their own
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Families — the shared home that owns the trip list and active trip
    match /families/{familyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Admins manage the family; a family with no admins yet is claimable
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.adminUids ||
        resource.data.adminUids.size() == 0
      );
    }

    // Trip config
    match /trips/{tripCode} {
      allow read: if request.auth != null;
      // Any authed user may create a new trip (doc must not already exist)
      allow create: if request.auth != null;
      // Update/delete: trip admin, unclaimed trip (no adminUid), or family admin
      allow update, delete: if request.auth != null && (
        !('adminUid' in resource.data) ||
        resource.data.adminUid == null ||
        resource.data.adminUid == request.auth.uid ||
        ('familyId' in resource.data && isFamilyAdminOf(resource.data.familyId))
      );

      // Itinerary subcollections — admin writes, member reads
      match /days/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }
      match /flights/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }
      match /hotels/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }
      match /driving/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }
      match /rentalCars/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }
      match /highlights/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }
      match /restaurants/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }
      match /quizQuestions/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }
      // Trip settings (e.g. shared AI config) — members read, admin writes
      match /settings/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }
      match /packing/{doc} {
        allow read: if request.auth != null;
        // Admin can add/delete items; all members can toggle checked
        allow write: if request.auth != null;
      }

      // Member-generated content — any authenticated user
      match /photos/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      match /quizAnswers/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      match /notes/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      match /travelLog/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // Passport stamps — admin creates/deletes, all members read
      match /passportStamps/{doc} {
        allow read: if request.auth != null;
        allow write: if isAdmin(tripCode);
      }

      // Earned stamps — any member can earn, all can read
      match /earnedStamps/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
  }
}
